    "test": "npm run typecheck && npm run test:render && npm run test:instantly"
  },
  "dependencies": { "@trigger.dev/sdk": "4.8.3" },
  "devDependencies": { "typescript": "^5.5.0", "@types/node": "^22.0.0", "tsx": "^4.19.0" }
}
