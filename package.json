{
  "name": "reply-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:knowledge": "node gen-knowledge.mjs",
    "dev": "npx trigger.dev@4.8.3 dev",
    "deploy": "npm run gen:knowledge && npx trigger.dev@4.8.3 deploy",
    "typecheck": "tsc --noEmit",
    "test:render": "npx tsx test/render.ts",
