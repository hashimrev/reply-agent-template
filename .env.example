# Set these as ENVIRONMENT VARIABLES in the client's Trigger.dev project (Environments -> Production), not in a file.
# This file only documents them. Never commit real values.

# --- Required ---
OPENROUTER_API_KEY=            # model calls (classify, free-text writer, guard)
SLACK_WEBHOOK_URL=             # incoming webhook for the positive-replies channel
BOOKING_LINK=                  # the owner's booking link (HubSpot meetings, Calendly, Cal.com...). With HubSpot the agent reads open times and
                               # offers up to 3; with anything else it sends the link only (see CLAUDE.md, calendar modes)



# --- Sending platform: set the key for the ONE you use. A scan task for a platform with no key does nothing ---
# Instantly (API v2). Key scopes: emails:read, emails:create, leads:read, campaigns:read, accounts:read
INSTANTLY_API_KEY=
INSTANTLY_MODE=shadow          # shadow | send
# EmailBison
EMAILBISON_API_KEY=
BISON_BASE_URL=                # e.g. https://send.yourdomain.com/api (required with EMAILBISON_API_KEY)
# PlusVibe
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=
PV_MODE=shadow

# --- Sending switch (EmailBison; Instantly and PlusVibe have their own switches above). Default is shadow: decide and post to Slack what WOULD be sent, send nothing ---
MODE=shadow                    # shadow | send
REFERRALS=                     # "send" to email referral addresses (needs MODE=send; not available on Instantly, drafts only)
NUDGES=                        # "off" to disable the 2 nudges
FREE_TEXT=                     # "off" to send everything outside the approved answers to a person
GRACE_MINUTES=5                # wait before auto-replying so a person can answer first
NUDGE_NOTICE_MINUTES=60        # Slack heads-up before a nudge goes out
MODEL=                         # default anthropic/claude-sonnet-5.5

# --- Slack reply bridge (a person answers from a Slack thread). Needs a bot token with chat:write + channels:history ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=              # the channel cards are posted to (required when SLACK_BOT_TOKEN is set)
SLACK_OWNER_USER_ID=           # tagged on "call booked" cards
SLACK_REPLY_USERS=             # comma-separated Slack user ids allowed to send from Slack

# --- HubSpot (optional: live calendar slots, booking, deal creation). Private-app token from the OWNER's portal ---
# scopes: scheduler.meetings.meeting-link.read, crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_NEW=             # stage id for "new positive reply"
HUBSPOT_STAGE_BOOKED=          # stage id for "call booked"

